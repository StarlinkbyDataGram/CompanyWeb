{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist/spa" }
    },
    {
      "src": "api/**/*.ts",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/assets/(.*)",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      },
      "continue": true
    },
    {
      "src": "/fonts/(.*)",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      },
      "continue": true
    },
    {
      "src": "/api/google-reviews",
      "dest": "/api/google-reviews.ts"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/serverless.ts"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)\\.(json|txt|xml|js|css|map|ico|png|jpe?g|gif|webp|avif|svg|woff2?|ttf|eot|webmanifest)$",
      "status": 404,
      "dest": "/404.html"
    },
    {
      "src": "/(.*)",
      "headers": {
        "Cache-Control": "public, max-age=0, must-revalidate"
      },
      "dest": "/spa.html"
    }
  ]
}
